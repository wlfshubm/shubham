# Copy this file to .env.local for local development (vercel dev reads it automatically).
# In production, set these in the Vercel dashboard: Project → Settings → Environment Variables.

# Required. Get one at https://resend.com/api-keys
RESEND_API_KEY=re_NnBLthg8_FCAeX6GxsyRmRtgPZL5xRTHx

# Optional. Inbox that receives contact-form messages.
CONTACT_TO_EMAIL=wlfshubm@gmail.com

# Optional. Must be an address on a domain you've verified in Resend
# (https://resend.com/domains). Until you verify a domain, leave this unset —
# it defaults to Resend's shared test sender, which only delivers to the
# email address on your Resend account.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
